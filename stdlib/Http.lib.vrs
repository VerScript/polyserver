! ═══════════════════════════════════════════════════════════════════
! VerScript Standard Library — Http
! Network Request Abstractions & Status Codes
! ═══════════════════════════════════════════════════════════════════

lib Http
  const:
    VERSION: "1.0.0"
    MODULE: "Network"
    STATUS_OK: 200
    STATUS_BAD_REQUEST: 400
    STATUS_NOT_FOUND: 404
    STATUS_SERVER_ERROR: 500

  dynamic:
    def func isSuccess statusCode
      reply (statusCode >= 200) & (statusCode < 300)

    def func isClientError statusCode
      reply (statusCode >= 400) & (statusCode < 500)

    def func isServerError statusCode
      reply (statusCode >= 500) & (statusCode < 600)
