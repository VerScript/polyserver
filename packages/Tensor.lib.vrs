! ═══════════════════════════════════════════════════════════════════
! VerScript Community Package — Tensor
! Vector Math, Linear Algebra Primitives & Neural Activations
! Requires explicit loading: load Tensor [as tensor]
! ═══════════════════════════════════════════════════════════════════

lib Tensor
  lib Ops
    dynamic:
      def func add a b
        set out: []
        if a.length() > 0 then
          iterate i from 0 to a.length() - 1
            set bVal: 0
            if i < b.length() then
              bVal: b[i]
            out.push(a[i] + bVal)
        reply out

      def func sub a b
        set out: []
        if a.length() > 0 then
          iterate i from 0 to a.length() - 1
            set bVal: 0
            if i < b.length() then
              bVal: b[i]
            out.push(a[i] - bVal)
        reply out

      def func mul a b
        set out: []
        if a.length() > 0 then
          iterate i from 0 to a.length() - 1
            set bVal: 1
            if i < b.length() then
              bVal: b[i]
            out.push(a[i] * bVal)
        reply out

      def func dot a b
        set sum: 0
        if a.length() > 0 then
          iterate i from 0 to a.length() - 1
            if i < b.length() then
              sum: sum + (a[i] * b[i])
        reply sum

      def func scale arr factor
        set out: []
        if arr.length() > 0 then
          iterate i from 0 to arr.length() - 1
            out.push(arr[i] * factor)
        reply out

  lib Activation
    dynamic:
      def func relu x
        if x > 0 then
          reply x
        reply 0

      def func step x
        if x >= 0 then
          reply 1
        reply 0

      def func clampVal x minVal maxVal
        if x < minVal then
          reply minVal
        if x > maxVal then
          reply maxVal
        reply x

  const:
    VERSION: "1.0.0"
    MODULE: "Tensor"
    PACKAGE_TYPE: "Community"

  dynamic:
    def func zeros count
      set out: []
      if count > 0 then
        iterate i from 0 to count - 1
          out.push(0)
      reply out

    def func ones count
      set out: []
      if count > 0 then
        iterate i from 0 to count - 1
          out.push(1)
      reply out

    def func dot a b
      reply Tensor.Ops.dot(a, b)

    def func relu x
      reply Tensor.Activation.relu(x)
