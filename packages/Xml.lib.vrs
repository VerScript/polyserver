! ═══════════════════════════════════════════════════════════════════
! VerScript Community Package — Xml
! Lightweight XML/HTML DOM Parser, Node Tree & Query Engine
! Requires explicit loading: load Xml [as xml]
! ═══════════════════════════════════════════════════════════════════

lib Xml
  lib Node
    const:
      KIND_TAG: "tag"
      KIND_TEXT: "text"

    dynamic:
      def func createTag tag attrs children
        reply ["tag", tag, attrs, children]

      def func createText text
        reply ["text", text, [], []]

      def func getTag node
        if node.length() > 1 then
          reply node[1]
        reply ""

      def func getChildren node
        if node.length() > 3 then
          reply node[3]
        reply []

      def func isTag node
        if node.length() > 0 then
          reply node[0] = "tag"
        reply false

  lib Query
    dynamic:
      def func findByTag node targetTag
        set results: []
        if Xml.Node.isTag(node) then
          if Xml.Node.getTag(node) = targetTag then
            results.push(node)
          set children: Xml.Node.getChildren(node)
          if children.length() > 0 then
            iterate i from 0 to children.length() - 1
              set subResults: findByTag(children[i], targetTag)
              if subResults.length() > 0 then
                iterate j from 0 to subResults.length() - 1
                  results.push(subResults[j])
        reply results

      def func extractText node
        if Xml.Node.isTag(node) then
          set out: ""
          set children: Xml.Node.getChildren(node)
          if children.length() > 0 then
            iterate i from 0 to children.length() - 1
              set ch: children[i]
              if ch.length() > 1 then
                if ch[0] = "text" then
                  out: out + ch[1]
                else
                  out: out + extractText(ch)
          reply out
        else if node.length() > 1 then
          reply node[1]
        reply ""

  const:
    VERSION: "1.0.0"
    MODULE: "Xml"
    PACKAGE_TYPE: "Community"

  dynamic:
    def func parse xmlStr
      set clean: xmlStr.trim()
      set startTagOpen: clean.indexOf("<")
      if startTagOpen < 0 then
        reply Xml.Node.createText(clean)
      set startTagClose: clean.indexOf(">")
      if startTagClose < 0 then
        reply Xml.Node.createText(clean)
      set tagHeader: clean.slice(startTagOpen + 1, startTagClose)
      set tagName: tagHeader
      set spaceIdx: tagHeader.indexOf(" ")
      if spaceIdx > 0 then
        tagName: tagHeader.slice(0, spaceIdx)

      set endTag: "</" + tagName + ">"
      set endTagIdx: clean.lastIndexOf(endTag)
      if endTagIdx < 0 then
        set selfClose: clean.indexOf("/>")
        if selfClose > 0 & selfClose < startTagClose then
          reply Xml.Node.createTag(tagName, [], [])
        reply Xml.Node.createTag(tagName, [], [])

      set innerContent: clean.slice(startTagClose + 1, endTagIdx)
      set children: []
      if innerContent.indexOf("<") >= 0 then
        children.push(parse(innerContent))
      else if innerContent.length() > 0 then
        children.push(Xml.Node.createText(innerContent))

      reply Xml.Node.createTag(tagName, [], children)

    def func stringify node
      if Xml.Node.isTag(node) then
        set tag: Xml.Node.getTag(node)
        set children: Xml.Node.getChildren(node)
        set inner: ""
        if children.length() > 0 then
          iterate i from 0 to children.length() - 1
            inner: inner + stringify(children[i])
        reply "<" + tag + ">" + inner + "</" + tag + ">"
      else if node.length() > 1 then
        reply node[1]
      reply ""

    def func find node targetTag
      reply Xml.Query.findByTag(node, targetTag)

    def func text node
      reply Xml.Query.extractText(node)
