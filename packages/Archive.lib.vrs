! ═══════════════════════════════════════════════════════════════════
! VerScript Community Package — Archive
! Multi-File Bundling & Semantic Versioning Tools
! Requires explicit loading: load Archive [as arc]
! ═══════════════════════════════════════════════════════════════════

lib Archive
  lib Zip
    dynamic:
      def func create
        reply ["zip", [], []]

      def func add archive path content
        set files: archive[1]
        set data: archive[2]
        files.push(path)
        data.push(content)
        reply true

      def func get archive path
        set files: archive[1]
        set data: archive[2]
        set idx: files.indexOf(path)
        if idx >= 0 then
          reply data[idx]
        reply ""

      def func files archive
        reply archive[1]

  lib Semver
    dynamic:
      def func parse verStr
        set parts: verStr.split(".")
        set major: 0
        set minor: 0
        set patch: 0
        if parts.length() > 0 then
          set p0: parts[0]
          major: p0.length()
        if parts.length() > 1 then
          set p1: parts[1]
          minor: p1.length()
        if parts.length() > 2 then
          set p2: parts[2]
          patch: p2.length()
        reply [major, minor, patch]

      def func compare v1 v2
        set p1: v1.split(".")
        set p2: v2.split(".")
        iterate i from 0 to 2
          set part1: "0000"
          set part2: "0000"
          if i < p1.length() then
            set raw1: p1[i]
            part1: raw1.padLeft(4, "0")
          if i < p2.length() then
            set raw2: p2[i]
            part2: raw2.padLeft(4, "0")
          if part1 > part2 then
            reply 1
          if part1 < part2 then
            reply -1
        reply 0

      def func isGreater v1 v2
        reply Archive.Semver.compare(v1, v2) > 0

  const:
    VERSION: "1.0.0"
    MODULE: "Archive"
    PACKAGE_TYPE: "Community"

  dynamic:
    def func bundle fileNames fileContents
      set combined: ""
      if fileNames.length() > 0 then
        iterate i from 0 to fileNames.length() - 1
          set f: fileNames[i]
          set c: fileContents[i]
          combined: combined + f + ":::" + c + "@@@"
      reply combined

    def func extract bundleStr
      set entries: bundleStr.split("@@@")
      set result: []
      if entries.length() > 0 then
        iterate i from 0 to entries.length() - 1
          set ent: entries[i]
          if ent.indexOf(":::") >= 0 then
            set kv: ent.split(":::")
            result.push(kv)
      reply result
