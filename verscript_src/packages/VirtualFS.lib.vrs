! ═══════════════════════════════════════════════════════════════════
! VerScript Community Package — VirtualFS
! In-Memory Hierarchical Virtual Filesystem & Sandbox Tree
! Requires explicit loading: load VirtualFS [as vfs]
! ═══════════════════════════════════════════════════════════════════

lib VirtualFS
  lib Path
    const:
      SEP: "/"

    dynamic:
      def func join a b
        if a = "" | a = "/" then
          if b.startsWith("/") then
            reply b
          reply "/" + b
        if a.endsWith("/") then
          if b.startsWith("/") then
            reply a + b.slice(1, b.length())
          reply a + b
        if b.startsWith("/") then
          reply a + b
        reply a + "/" + b

      def func normalize path
        if path = "" | path = "/" then
          reply "/"
        set norm_path: path
        if norm_path.endsWith("/") & norm_path.length() > 1 then
          norm_path: norm_path.slice(0, norm_path.length() - 1)
        if not norm_path.startsWith("/") then
          norm_path: "/" + norm_path
        reply norm_path

      def func dirname path
        if path = "" | path = "/" then
          reply "/"
        set norm: normalize(path)
        set lastSlash: norm.lastIndexOf("/")
        if lastSlash <= 0 then
          reply "/"
        reply norm.slice(0, lastSlash)

      def func basename path
        if path = "" | path = "/" then
          reply ""
        set norm: normalize(path)
        set lastSlash: norm.lastIndexOf("/")
        if lastSlash < 0 then
          reply norm
        reply norm.slice(lastSlash + 1, norm.length())

      def func extname path
        set base: basename(path)
        set dotIdx: base.lastIndexOf(".")
        if dotIdx < 0 then
          reply ""
        reply base.slice(dotIdx, base.length())

  lib Node
    const:
      TYPE_FILE: 1
      TYPE_DIR: 2

    dynamic:
      def func createFile name content
        reply ["file", name, content]

      def func createDir name
        reply ["dir", name, []]

      def func isDirNode node
        if node.length() > 0 then
          reply node[0] = "dir"
        reply false

  const:
    VERSION: "1.0.0"
    MODULE: "VirtualFS"
    PACKAGE_TYPE: "Community"

  dynamic:
    __dirs: ["/"]
    __files: []
    __contents: []
    __pwd: "/"

    def func pwd
      reply __pwd

    def func cd target
      if target = "/" | target = "" then
        __pwd: "/"
        reply __pwd
      if target = ".." then
        __pwd: VirtualFS.Path.dirname(__pwd)
        reply __pwd
      set resolved: ""
      if target.startsWith("/") then
        resolved: VirtualFS.Path.normalize(target)
      else
        resolved: VirtualFS.Path.normalize(VirtualFS.Path.join(__pwd, target))
      if not __dirs.contains(resolved) then
        throw FileError ?msg="Path not found"
      __pwd: resolved
      reply __pwd

    def func mkdir path
      set target: ""
      if path.startsWith("/") then
        target: VirtualFS.Path.normalize(path)
      else
        target: VirtualFS.Path.normalize(VirtualFS.Path.join(__pwd, path))
      if not __dirs.contains(target) then
        set parent: VirtualFS.Path.dirname(target)
        if parent != "/" & not __dirs.contains(parent) then
          mkdir(parent)
        __dirs.push(target)
      reply true

    def func touch path
      set target: ""
      if path.startsWith("/") then
        target: VirtualFS.Path.normalize(path)
      else
        target: VirtualFS.Path.normalize(VirtualFS.Path.join(__pwd, path))
      set parent: VirtualFS.Path.dirname(target)
      mkdir(parent)
      if not __files.contains(target) then
        __files.push(target)
        __contents.push("")
      reply true

    def func writeFile path content
      set target: ""
      if path.startsWith("/") then
        target: VirtualFS.Path.normalize(path)
      else
        target: VirtualFS.Path.normalize(VirtualFS.Path.join(__pwd, path))
      set parent: VirtualFS.Path.dirname(target)
      mkdir(parent)
      set idx: __files.indexOf(target)
      if idx >= 0 then
        __contents[idx]: content
      else
        __files.push(target)
        __contents.push(content)
      reply true

    def func write path content
      reply writeFile(path, content)

    def func readFile path
      set target: ""
      if path.startsWith("/") then
        target: VirtualFS.Path.normalize(path)
      else
        target: VirtualFS.Path.normalize(VirtualFS.Path.join(__pwd, path))
      set idx: __files.indexOf(target)
      if idx < 0 then
        throw FileError ?msg="Path not found"
      reply __contents[idx]

    def func read path
      reply readFile(path)

    def func appendFile path text
      set target: ""
      if path.startsWith("/") then
        target: VirtualFS.Path.normalize(path)
      else
        target: VirtualFS.Path.normalize(VirtualFS.Path.join(__pwd, path))
      set idx: __files.indexOf(target)
      if idx >= 0 then
        __contents[idx]: __contents[idx] + text
      else
        writeFile(target, text)
      reply true

    def func append path text
      reply appendFile(path, text)

    def func deleteFile path
      set target: ""
      if path.startsWith("/") then
        target: VirtualFS.Path.normalize(path)
      else
        target: VirtualFS.Path.normalize(VirtualFS.Path.join(__pwd, path))
      set fIdx: __files.indexOf(target)
      if fIdx >= 0 then
        __files.slice(fIdx, fIdx + 1)
        __contents.slice(fIdx, fIdx + 1)
        reply true
      set dIdx: __dirs.indexOf(target)
      if dIdx > 0 then
        __dirs.slice(dIdx, dIdx + 1)
        reply true
      reply false

    def func rm path
      reply deleteFile(path)

    def func ls path
      set target: ""
      if path = "" | path = "." then
        target: __pwd
      else if path.startsWith("/") then
        target: VirtualFS.Path.normalize(path)
      else
        target: VirtualFS.Path.normalize(VirtualFS.Path.join(__pwd, path))
      set children: []
      iterate i from 0 to __dirs.length() - 1
        set d: __dirs[i]
        if d != "/" & d != target then
          if VirtualFS.Path.dirname(d) = target then
            children.push(VirtualFS.Path.basename(d) + "/")
      iterate j from 0 to __files.length() - 1
        set f: __files[j]
        if VirtualFS.Path.dirname(f) = target then
          children.push(VirtualFS.Path.basename(f))
      reply children

    def func list path
      reply ls(path)

    def func exists path
      set target: ""
      if path.startsWith("/") then
        target: VirtualFS.Path.normalize(path)
      else
        target: VirtualFS.Path.normalize(VirtualFS.Path.join(__pwd, path))
      if __dirs.contains(target) then
        reply true
      if __files.contains(target) then
        reply true
      reply false

    def func isDir path
      set target: ""
      if path.startsWith("/") then
        target: VirtualFS.Path.normalize(path)
      else
        target: VirtualFS.Path.normalize(VirtualFS.Path.join(__pwd, path))
      reply __dirs.contains(target)

    def func isFile path
      set target: ""
      if path.startsWith("/") then
        target: VirtualFS.Path.normalize(path)
      else
        target: VirtualFS.Path.normalize(VirtualFS.Path.join(__pwd, path))
      reply __files.contains(target)

    def func size path
      set target: ""
      if path.startsWith("/") then
        target: VirtualFS.Path.normalize(path)
      else
        target: VirtualFS.Path.normalize(VirtualFS.Path.join(__pwd, path))
      set idx: __files.indexOf(target)
      if idx < 0 then
        reply 0
      set strVal: __contents[idx]
      reply strVal.length()

    def func exportJson
      set dirStr: __dirs.join(";;")
      set fileStr: __files.join(";;")
      set contentStr: __contents.join(";;")
      reply __pwd + "@@@" + dirStr + "@@@" + fileStr + "@@@" + contentStr

    def func importJson snapshot
      set parts: snapshot.split("@@@")
      if parts.length() >= 4 then
        set p0: parts[0]
        set p1: parts[1]
        set p2: parts[2]
        set p3: parts[3]
        __pwd: p0
        if p1.length() > 0 then
          __dirs: p1.split(";;")
        else
          __dirs: ["/"]
        if p2.length() > 0 then
          __files: p2.split(";;")
        else
          __files: []
        if p3.length() > 0 then
          __contents: p3.split(";;")
        else
          __contents: []
      reply true

    def func reset
      __dirs: ["/"]
      __files: []
      __contents: []
      __pwd: "/"
      reply true
