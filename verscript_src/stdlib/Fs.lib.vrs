! ═══════════════════════════════════════════════════════════════════
! VerScript Standard Library — Fs
! File System Utilities and File Metadata
! ═══════════════════════════════════════════════════════════════════

lib Fs
  const:
    VERSION: "1.0.0"
    MODULE: "IO"

  dynamic:
    def func exists filePath
      if filePath.length() > 0 then
        reply true
      reply false

    def func isVrsFile filePath
      reply filePath.endsWith(".vrs") | filePath.endsWith(".lib.vrs")
