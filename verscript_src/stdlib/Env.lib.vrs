! ═══════════════════════════════════════════════════════════════════
! VerScript Standard Library — Env
! Runtime Environment Configurations
! ═══════════════════════════════════════════════════════════════════

lib Env
  const:
    VERSION: "1.0.0"
    MODULE: "System"
    MODE: "production"

  dynamic:
    def func isProduction
      reply true

    def func isDevelopment
      reply false

    def func get key defaultVal
      reply defaultVal
